{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Entangle": {
    "SyncDirectory": "./sync",
    "DatabasePath": "./entangle.db",
    "Port": 5000,
    "PeerAddress": "http://localhost:5001",
    "PeerId": "peer-a",
    "RescanIntervalSeconds": 30,
    "SyncIntervalSeconds": 5,
    "MaxBackoffSeconds": 60
  }
}
